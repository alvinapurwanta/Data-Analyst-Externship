# Creating a tuple of fruits
fruits_tuple = ("apple", "banana", "cherry")

# Accessing an item
print(fruits_tuple[0])  # This will print "apple"

# Trying to change a value (this will raise an error because tuples are immutable)
# fruits_tuple[1] = "orange"




